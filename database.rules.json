{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      ".indexOn": [
        "meta/last"
      ],
      "$code": {
        ".write": "(auth != null) && (((!newData.exists()) && ((data.child('meta/owner').val() === auth.uid) || (data.child('meta/last').val() < now - 86400000))) || (((!data.exists()) || (data.child('meta/last').val() < now - 86400000)) && (newData.child('meta/owner').val() === auth.uid) && (newData.child('members/' + auth.uid).exists()) && (!newData.child('msgs').exists()) && (!newData.child('dm').exists()) && (!newData.child('banned').exists())))",
        ".validate": "($code.matches(/^[2-9A-HJKMNP-Z]{4}$/)) && (newData.hasChild('meta'))",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && data.child('owner').val() === auth.uid",
          ".validate": "(newData.hasChildren(['owner', 'created', 'last', 'priv'])) && ((!data.child('enc').exists()) || (newData.child('enc').val() === data.child('enc').val()) || (data.child('last').val() < now - 86400000))",
          "owner": {
            ".validate": "newData.isString() && (newData.val() === auth.uid || newData.val() === data.val())"
          },
          "created": {
            ".validate": "newData.isNumber()"
          },
          "last": {
            ".write": "auth != null && newData.parent().parent().child('members/' + auth.uid).exists()",
            ".validate": "newData.val() === now"
          },
          "priv": {
            ".validate": "newData.isBoolean()"
          },
          "locked": {
            ".validate": "newData.isBoolean()"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length <= 40 && newData.parent().child('enc').val() !== true"
          },
          "enc": {
            ".validate": "newData.isBoolean()"
          },
          "kc": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "xt": {
            ".validate": "newData.isString() && newData.val().length <= 400 && newData.val().matches(/^[A-Za-z0-9_-]+$/) && newData.parent().child('enc').val() === true"
          },
          "$other": {
            ".validate": false
          }
        },
        "members": {
          ".read": "auth != null && data.child(auth.uid).exists()",
          "$uid": {
            ".write": "(auth != null) && (((auth.uid === $uid) && (!data.parent().parent().child('banned/' + $uid).exists()) && ((data.exists()) || ((data.parent().parent().child('meta').exists()) && (data.parent().parent().child('meta/last').val() >= now - 86400000) && (data.parent().parent().child('meta/locked').val() !== true) && ((data.parent().parent().child('meta/priv').val() !== true) || ((root.child('secrets/' + $code).exists()) && (newData.parent().parent().child('keys/' + $uid).val() === root.child('secrets/' + $code).val())))))) || ((!newData.exists()) && (data.parent().parent().child('meta/owner').val() === auth.uid)))",
            ".validate": "newData.hasChild('joined') && (newData.hasChildren(['name', 'avatar']) || newData.hasChildren(['x', 'h']))",
            "name": {
              ".validate": "(newData.isString() && newData.val().length <= 24) && (newData.val().length > 0) && (!newData.val().matches(/[.#$\\[\\]\\/]/)) && (!(newData.parent().parent().parent().child('meta/enc').val() === true)) && (newData.parent().parent().parent().child('names/' + newData.val().toLowerCase()).val() === $uid)"
            },
            "avatar": {
              ".validate": "newData.isString() && newData.val().length <= 8 && !(newData.parent().parent().parent().child('meta/enc').val() === true)"
            },
            "x": {
              ".validate": "newData.isString() && newData.val().length <= 600 && newData.val().matches(/^[A-Za-z0-9_-]+$/) && (newData.parent().parent().parent().child('meta/enc').val() === true)"
            },
            "h": {
              ".validate": "(newData.isString() && newData.val().length <= 24) && (newData.val().matches(/^[0-9a-f]{24}$/)) && ((newData.parent().parent().parent().child('meta/enc').val() === true)) && (newData.parent().parent().parent().child('names/' + newData.val()).val() === $uid)"
            },
            "pk": {
              ".validate": "newData.isString() && newData.val().length <= 120 && newData.val().matches(/^[A-Za-z0-9_-]+$/)"
            },
            "joined": {
              ".validate": "newData.isNumber()"
            },
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "names": {
          "$key": {
            ".read": "auth != null",
            ".write": "(auth != null) && (((newData.val() === auth.uid) && ((!data.exists()) || (data.val() === auth.uid) || (!data.parent().parent().child('members/' + data.val()).exists()))) || ((!newData.exists()) && ((data.val() === auth.uid) || (!data.parent().parent().child('members/' + data.val()).exists()) || (data.parent().parent().child('meta/owner').val() === auth.uid))))",
            ".validate": "newData.isString() && $key.length <= 24"
          }
        },
        "keys": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val().length <= 128"
          }
        },
        "banned": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && data.parent().parent().child('meta/owner').val() === auth.uid",
            ".validate": "newData.val() === true"
          }
        },
        "msgs": {
          ".read": "auth != null && data.parent().child('members/' + auth.uid).exists()",
          "$id": {
            ".write": "(auth != null) && (data.parent().parent().child('members/' + auth.uid).exists()) && (((!data.exists()) && (newData.child('by').val() === auth.uid)) || ((!newData.exists()) && (data.child('by').val() === auth.uid)))",
            ".validate": "(newData.hasChildren(['by', 'at'])) && ((((newData.parent().parent().child('meta/enc').val() === true)) && (newData.hasChild('x'))) || ((!(newData.parent().parent().child('meta/enc').val() === true)) && (newData.hasChildren(['name', 'avatar'])) && (newData.hasChild('text') || newData.hasChild('gif'))))",
            "by": {
              ".validate": "newData.isString()"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 24 && !(newData.parent().parent().parent().child('meta/enc').val() === true)"
            },
            "avatar": {
              ".validate": "newData.isString() && newData.val().length <= 8 && !(newData.parent().parent().parent().child('meta/enc').val() === true)"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length <= 1000 && newData.val().length > 0 && !(newData.parent().parent().parent().child('meta/enc').val() === true)"
            },
            "gif": {
              ".validate": "newData.hasChildren(['url', 'w', 'h']) && !(newData.parent().parent().parent().child('meta/enc').val() === true)",
              "url": {
                ".validate": "newData.isString() && newData.val().length <= 500 && newData.val().matches(/^https:\\/\\/([a-z0-9-]+\\.)*klipy\\.com\\//)"
              },
              "w": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 2000"
              },
              "h": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 2000"
              },
              "title": {
                ".validate": "newData.isString() && newData.val().length <= 120"
              },
              "$other": {
                ".validate": false
              }
            },
            "x": {
              ".validate": "newData.isString() && newData.val().length <= 4000 && newData.val().matches(/^[A-Za-z0-9_-]+$/)"
            },
            "at": {
              ".validate": "newData.val() === now || newData.val() === data.val()"
            },
            "re": {
              "$k": {
                ".validate": "$k.matches(/^[0-5]$/)",
                "$uid": {
                  ".write": "auth != null && auth.uid === $uid && data.parent().parent().parent().parent().parent().child('members/' + auth.uid).exists()",
                  ".validate": "newData.val() === true"
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "dm": {
          "$pair": {
            ".read": "auth != null && ($pair.beginsWith(auth.uid + '_') || $pair.endsWith('_' + auth.uid)) && data.parent().parent().child('members/' + auth.uid).exists()",
            "$id": {
              ".write": "(auth != null) && (!data.exists()) && (newData.child('by').val() === auth.uid) && (($pair === auth.uid + '_' + newData.child('to').val()) || ($pair === newData.child('to').val() + '_' + auth.uid)) && (data.parent().parent().parent().child('members/' + auth.uid).exists()) && (data.parent().parent().parent().child('members/' + newData.child('to').val()).exists())",
              ".validate": "newData.hasChildren(['by', 'to', 'at', 'x'])",
              "by": {
                ".validate": "newData.isString()"
              },
              "to": {
                ".validate": "newData.isString()"
              },
              "x": {
                ".validate": "newData.isString() && newData.val().length <= 4000 && newData.val().matches(/^[A-Za-z0-9_-]+$/)"
              },
              "at": {
                ".validate": "newData.val() === now"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "secrets": {
      "$code": {
        ".write": "(auth != null) && ((newData.parent().parent().child('rooms/' + $code + '/meta/owner').val() === auth.uid) || (!newData.exists() && !newData.parent().parent().child('rooms/' + $code).exists()))",
        ".validate": "newData.isString() && newData.val().length <= 128"
      }
    }
  }
}
